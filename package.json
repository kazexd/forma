{
  "name": "portrait-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "test": "vitest run && vitest run --config vitest.server.config.ts",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "openai": "^7.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "jsdom": "^26.0.0",
    "supertest": "^7.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.12"
  }
}
