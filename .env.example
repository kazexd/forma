# Server-only secret. Never use a NEXT_PUBLIC_ prefix for this key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Public Supabase project configuration (also used by the local backend).
# Use the publishable key or legacy anon key, NEVER a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
