# Server-only secret. Never use a NEXT_PUBLIC_ prefix for this key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Public Supabase project configuration (also used by the local backend).
# Use the publishable key or legacy anon key, NEVER a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: use the Supabase service_role key or secret key. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe test mode only; live secret keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time Stripe TEST price: US$1.00, currency USD (100 cents).
STRIPE_PRICE_ID=
# Conservative defaults: generation attempts per user per UTC day; unpaid retention.
DAILY_GENERATION_LIMIT=3
UNPAID_RETENTION_DAYS=7
