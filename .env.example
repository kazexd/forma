# Server-only provider switch: openai (default) or openrouter. Restart/redeploy to apply.
IMAGE_PROVIDER=openai
OPENROUTER_API_KEY=
# Supported OpenRouter models (exact IDs):
# openai/gpt-image-2 (default)
# qwen/qwen-image-2.1-turbo
# bytedance-seed/seedream-5-0-flash
# bytedance-seed/seedream-5-5
# google/gemini-nano-banana-2.1
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2

# Server-only secret. Never use a NEXT_PUBLIC_ prefix for this key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Public Supabase project configuration (also used by the local backend).
# Use the publishable key or legacy anon key, NEVER a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: use the Supabase service_role key or secret key. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe test mode only; live secret keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time Stripe TEST price: US$3.99, currency USD (399 cents).
STRIPE_PRICE_ID=
# One-time Stripe TEST package: US$5.49, 5 generations + 2 unlock credits.
STRIPE_PACKAGE_PRICE_ID=

# Production defaults to disabled. Development defaults to enabled if omitted.
# Explicit false disables new operations; existing purchases remain accessible.
GENERATION_ENABLED=false
CHECKOUT_ENABLED=false

# Cloudflare Turnstile. Required for production generation; never expose the secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact hostname (no scheme/path). Render's RENDER_EXTERNAL_HOSTNAME is used if omitted.
TURNSTILE_HOSTNAME=
# Optional trusted public HTTPS origin (no path); Render's external URL is used if omitted.
# Set this when adding a custom domain or deploying outside Render.
APP_ORIGIN=
